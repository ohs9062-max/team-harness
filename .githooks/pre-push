#!/usr/bin/env bash
set -euo pipefail
root=$(git rev-parse --show-toplevel)
needs_canary=0
needs_crosscheck=0
crosscheck_ok=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ $local_sha =~ ^0+$ ]] && continue
  if [[ $remote_sha =~ ^0+$ ]]; then
    revisions=$(git rev-list "$local_sha" --not --remotes)
  else
    revisions=$(git rev-list "$local_sha" "^$remote_sha")
  fi
  while read -r revision; do
    [[ -n $revision ]] || continue
    if git diff-tree --root -m --no-commit-id --name-only -r "$revision" | grep -E '^(scripts/|src/team_harness/)' > /dev/null; then
      needs_canary=1
    fi
    while IFS= read -r number; do
      [[ -n $number ]] || continue
      if ! git show "$revision^:design/decisions.md" 2>/dev/null | grep -Eq "^## TH-D${number}([.[:space:]]|$)"; then
        needs_crosscheck=1
      fi
    done < <(git diff-tree --root -m -p --no-commit-id "$revision" -- design/decisions.md | sed -nE 's/^\+## TH-D([0-9]+)([.[:space:]]|$).*/\1/p')
    while IFS= read -r trailer; do
      folder=${trailer#Crosscheck: }
      if [[ -f "$folder/CROSSCHECK.md" ]] && awk '/^## 코디네이터 결정$/ {getline; if ($0 !~ /^시각: /) next; getline; if ($0 == "결정: 채택") valid=1} END {exit !valid}' "$folder/CROSSCHECK.md"; then
        crosscheck_ok=1
      fi
    done < <(git show -s --format=%B "$revision" | git interpret-trailers --parse | grep '^Crosscheck: ' || true)
  done <<< "$revisions"
done
if (( needs_canary )); then
  skip=${TH_CANARY_SKIP:-}
  if [[ -n ${skip//[[:space:]]/} ]]; then
    watch_dir=${TH_WATCH_DIR:-"$HOME/.team-harness/watch"}
    mkdir -p "$watch_dir"
    reason=${TH_CANARY_SKIP//$'\n'/ }
    printf '%s [canary skip] %s\n' "$(date '+%F %T')" "$reason" >> "$watch_dir/events.log"
  else
    "$root/scripts/th-canary.sh" "$root"
  fi
fi

if (( needs_crosscheck && ! crosscheck_ok )); then
  skip=${TH_CROSSCHECK_SKIP:-}
  if [[ -n ${skip//[[:space:]]/} ]]; then
    watch_dir=${TH_WATCH_DIR:-"$HOME/.team-harness/watch"}
    mkdir -p "$watch_dir"
    reason=${TH_CROSSCHECK_SKIP//$'\n'/ }
    printf '%s [crosscheck skip] %s\n' "$(date '+%F %T')" "$reason" >> "$watch_dir/events.log"
  else
    echo '새 TH-D 결정에는 채택된 Crosscheck 트레일러 또는 TH_CROSSCHECK_SKIP 사유가 필요합니다' >&2
    exit 1
  fi
fi
